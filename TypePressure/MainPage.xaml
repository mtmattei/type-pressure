<Page x:Class="TypePressure.MainPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:render="using:TypePressure.Rendering" Background="{StaticResource Paper}" KeyDown="OnKeyDown" IsTabStop="True" KeyboardAcceleratorPlacementMode="Hidden">
 <Page.KeyboardAccelerators><KeyboardAccelerator Key="Escape" Invoked="EscapeAccelerator"/></Page.KeyboardAccelerators>
 <Grid x:Name="Root" RowDefinitions="98,*,136,40" Background="{StaticResource Paper}" PointerMoved="DemoPointerMoved">
  <VisualStateManager.VisualStateGroups><VisualStateGroup><VisualState x:Name="Compact"><VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0"/></VisualState.StateTriggers><VisualState.Setters><Setter Target="HeaderNote.Visibility" Value="Collapsed"/><Setter Target="KeyboardHints.Visibility" Value="Collapsed"/><Setter Target="ControlsGrid.ColumnSpacing" Value="16"/><Setter Target="ControlsGrid.Padding" Value="24,20"/><Setter Target="FontColumn.Width" Value="150"/><Setter Target="TextColumn.Width" Value="160"/><Setter Target="SlantCaption.Visibility" Value="Collapsed"/></VisualState.Setters></VisualState><VisualState x:Name="Wide"><VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="1150"/></VisualState.StateTriggers></VisualState></VisualStateGroup></VisualStateManager.VisualStateGroups>
  <Border x:Name="Header" BorderBrush="{StaticResource Rule}" BorderThickness="0,0,0,1">
   <Grid Margin="36,0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="36">
    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center"><StackPanel Spacing="5" VerticalAlignment="Center"><Rectangle Fill="{StaticResource Accent}" Width="30" Height="5"/><Rectangle Fill="{StaticResource Accent}" Width="18" Height="5"/><Rectangle Fill="{StaticResource Accent}" Width="30" Height="5"/></StackPanel><TextBlock Text="TYPE&#10;PRESSURE®" Style="{StaticResource Brand}"/></StackPanel>
    <Border Grid.Column="1" x:Name="HeaderNote" BorderBrush="{StaticResource Rule}" BorderThickness="1,0,0,0" Padding="32,0" VerticalAlignment="Center"><StackPanel Spacing="6"><TextBlock Style="{StaticResource Micro}" Text="AN EXPERIMENT IN VARIABLE TYPE"/><TextBlock Style="{StaticResource Note}" Text="Letterforms under the influence."/></StackPanel></Border>
    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
     <Button x:Uid="Chamber.Button.Demo" x:Name="DemoButton" Click="DemoClick" Style="{StaticResource QuietButton}" AutomationProperties.Name="Demo mode" ToolTipService.ToolTip="Loop a control-free type showcase (D)"><StackPanel Orientation="Horizontal" Spacing="9"><FontIcon Glyph="&#xE768;" FontSize="12"/><TextBlock Text="Demo" Style="{StaticResource Body}"/></StackPanel></Button>
     <Button x:Uid="Chamber.Button.Help" Click="HelpClick" Style="{StaticResource QuietButton}" AutomationProperties.Name="How to play"><StackPanel Orientation="Horizontal" Spacing="9"><FontIcon Glyph="&#xE897;" FontSize="15"/><TextBlock Text="How to play" Style="{StaticResource Body}"/></StackPanel></Button>
     <Rectangle Width="1" Height="18" Fill="{StaticResource Rule}" Margin="4,0"/>
     <Button x:Uid="Chamber.Button.Save" Style="{StaticResource QuietButton}" AutomationProperties.Name="Save specimen"><StackPanel Orientation="Horizontal" Spacing="9"><FontIcon Glyph="&#xE74E;" FontSize="15"/><TextBlock Text="Save specimen" Style="{StaticResource Body}"/></StackPanel><Button.Flyout><MenuFlyout><MenuFlyoutItem Text="Save as PNG (2×)" Tag="png" Click="SaveClick"/><MenuFlyoutItem Text="Save as SVG vectors" Tag="svg" Click="SaveClick"/></MenuFlyout></Button.Flyout></Button>
     <Button x:Uid="Chamber.Button.Fullscreen" Click="FullscreenClick" Style="{StaticResource QuietButton}" AutomationProperties.Name="Toggle fullscreen" ToolTipService.ToolTip="Fullscreen (F11)"><FontIcon Glyph="&#xE740;" FontSize="16"/></Button>
    </StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Row="1" x:Name="Stage">
   <render:PressureCanvas x:Name="Chamber" AutomationProperties.Name="Interactive variable type chamber. Hold to inflate. Drag to bend. F selects a force; arrow keys move it; Delete removes it."/>
   <Grid x:Name="ExperimentsBar" VerticalAlignment="Top" Margin="36,25,36,0" ColumnDefinitions="*,Auto">
    <StackPanel Spacing="8"><TextBlock Style="{StaticResource Micro}" Text="CHOOSE YOUR EXPERIMENT"/><StackPanel Orientation="Horizontal" Spacing="4">
     <ToggleButton x:Name="BreathingButton" x:Uid="Chamber.Preset.Breathing" Content="01   Breathing room" Tag="Breathing" IsChecked="True" Style="{StaticResource PresetButton}" Click="PresetClick"/>
     <ToggleButton x:Name="TugButton" x:Uid="Chamber.Preset.Tug" Content="02   Tug of war" Tag="Tug" Style="{StaticResource PresetButton}" Click="PresetClick"/>
     <ToggleButton x:Name="ShockButton" x:Uid="Chamber.Preset.Aftershock" Content="03   Aftershock" Tag="Aftershock" Style="{StaticResource PresetButton}" Click="PresetClick"/>
     <ToggleButton x:Name="StormButton" x:Uid="Chamber.Preset.Storm" Content="04   Specimen storm" Tag="Storm" Style="{StaticResource PresetButton}" Click="PresetClick"/>
    </StackPanel></StackPanel>
    <Button Grid.Column="1" x:Uid="Chamber.Button.AddForce" x:Name="AddForceButton" Content="+   Add a force" Style="{StaticResource QuietButton}" BorderBrush="{StaticResource Rule}" BorderThickness="1" VerticalAlignment="Bottom">
     <Button.Flyout><MenuFlyout><MenuFlyoutItem Text="Inflate — make letters heavier" Tag="Inflate" Click="AddForceClick"/><MenuFlyoutItem Text="Compress — squeeze letterforms" Tag="Compress" Click="AddForceClick"/><MenuFlyoutItem x:Name="LeanForceItem" Text="Lean — pull letters into a slant" Tag="Lean" Click="AddForceClick"/><MenuFlyoutItem Text="Oscillate — a moving wave" Tag="Oscillate" Click="AddForceClick"/><MenuFlyoutSeparator/><MenuFlyoutItem Text="Remove selected force" Click="RemoveForceClick"/></MenuFlyout></Button.Flyout>
    </Button>
   </Grid>
  </Grid>
  <Border x:Name="ControlDeck" Grid.Row="2" Background="{StaticResource Deck}" BorderBrush="{StaticResource Rule}" BorderThickness="0,1">
   <Grid x:Name="ControlsGrid" Padding="36,24" ColumnSpacing="28"><Grid.ColumnDefinitions><ColumnDefinition x:Name="FontColumn" Width="180"/><ColumnDefinition x:Name="TextColumn" Width="205"/><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions>
    <StackPanel Spacing="7"><TextBlock Style="{StaticResource Micro}" Text="01 — TYPEFACE"/><ComboBox x:Name="FontSelect" x:Uid="Chamber.Input.Font" AutomationProperties.Name="Typeface" SelectedIndex="0" SelectionChanged="FontChanged" BorderThickness="0" Background="Transparent" Padding="0,0,28,0" FontSize="18" HorizontalAlignment="Stretch"><ComboBoxItem Content="Roboto Flex"/><ComboBoxItem Content="Anybody"/></ComboBox><TextBlock x:Name="FontNote" Text="13 axes. Endless possibilities." Style="{StaticResource Note}"/></StackPanel>
    <Border Grid.Column="1" BorderBrush="{StaticResource Rule}" BorderThickness="1,0,0,0" Padding="24,0,0,0"><StackPanel Spacing="6"><TextBlock Style="{StaticResource Micro}" Text="02 — YOUR MATERIAL"/><TextBox x:Name="MaterialInput" x:Uid="Chamber.Input.Text" AutomationProperties.Name="Your text" Text="PRESSURE" MaxLength="22" TextChanged="MaterialChanged" Style="{StaticResource MaterialInput}"/><TextBlock Text="Start typing to make it yours." Style="{StaticResource Note}"/></StackPanel></Border>
    <Grid Grid.Column="2" ColumnDefinitions="*,*,*" ColumnSpacing="24" Margin="0,5,0,0">
     <StackPanel><Grid ColumnDefinitions="*,Auto"><TextBlock Text="WEIGHT" Style="{StaticResource Micro}"/><TextBlock Grid.Column="1" x:Name="WeightValue" Text="650" Style="{StaticResource Value}"/></Grid><Slider x:Name="WeightSlider" x:Uid="Chamber.Input.Weight" AutomationProperties.Name="Weight" Minimum="100" Maximum="1000" Value="650" ValueChanged="AxisChanged" Style="{StaticResource AxisSlider}"/><Grid ColumnDefinitions="*,Auto"><TextBlock Text="Thin" Style="{StaticResource Note}"/><TextBlock Grid.Column="1" Text="Black" Style="{StaticResource Note}"/></Grid></StackPanel>
     <StackPanel Grid.Column="1"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="WIDTH" Style="{StaticResource Micro}"/><TextBlock Grid.Column="1" x:Name="WidthValue" Text="100" Style="{StaticResource Value}"/></Grid><Slider x:Name="WidthSlider" x:Uid="Chamber.Input.Width" AutomationProperties.Name="Width" Minimum="25" Maximum="151" Value="100" ValueChanged="AxisChanged" Style="{StaticResource AxisSlider}"/><Grid ColumnDefinitions="*,Auto"><TextBlock Text="Condensed" Style="{StaticResource Note}"/><TextBlock Grid.Column="1" Text="Expanded" Style="{StaticResource Note}"/></Grid></StackPanel>
     <StackPanel Grid.Column="2" x:Name="SlantControls"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="SLANT" Style="{StaticResource Micro}"/><TextBlock Grid.Column="1" x:Name="SlantValue" Text="0°" Style="{StaticResource Value}"/></Grid><Slider x:Name="SlantSlider" x:Uid="Chamber.Input.Slant" AutomationProperties.Name="Slant" Minimum="-10" Maximum="0" Value="0" StepFrequency="0.1" ValueChanged="AxisChanged" Style="{StaticResource AxisSlider}"/><Grid x:Name="SlantCaption" ColumnDefinitions="*,Auto"><TextBlock Text="Leaning" Style="{StaticResource Note}"/><TextBlock Grid.Column="1" Text="Upright" Style="{StaticResource Note}"/></Grid></StackPanel>
    </Grid>
    <StackPanel Grid.Column="3" Spacing="4" Margin="10,0,0,0"><Button x:Name="FreezeButton" x:Uid="Chamber.Button.Freeze" Content="Ⅱ   Freeze      ␣" Style="{StaticResource PrimaryButton}" Click="FreezeClick" HorizontalAlignment="Stretch"/><Button x:Uid="Chamber.Button.Reset" Content="↺   Reset chamber" Style="{StaticResource QuietButton}" Click="ResetClick" FontSize="10"/></StackPanel>
   </Grid>
  </Border>
  <Grid x:Name="StatusBar" Grid.Row="3" Margin="36,0" ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center"><StackPanel Orientation="Horizontal" Spacing="9"><Ellipse x:Name="LiveDot" Width="5" Height="5" Fill="{StaticResource Live}"/><TextBlock x:Name="LiveLabel" Text="LIVE SIMULATION" Style="{StaticResource Micro}"/><TextBlock Text=" / " Style="{StaticResource Micro}"/><TextBlock x:Name="FieldCount" Text="0 FORCE FIELDS" Style="{StaticResource Micro}"/></StackPanel><TextBlock Grid.Column="1" x:Name="KeyboardHints" Text="HOLD TO INFLATE  ·  DRAG TO BEND  ·  D TO DEMO" Style="{StaticResource Micro}" HorizontalAlignment="Center"/><TextBlock Grid.Column="2" Text="NOTHING HERE IS STATIC  ✳" Style="{StaticResource Micro}"/></Grid>
  <Border x:Name="ToastHost" Grid.RowSpan="4" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="24,0,24,60" Background="{StaticResource Ink}" Padding="20,12" CornerRadius="4" Visibility="Collapsed"><TextBlock x:Name="ToastText" Style="{StaticResource Body}" Foreground="{StaticResource Paper}"/></Border>
  <Button x:Name="DemoExitButton" Grid.RowSpan="4" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="24" Content="×   Exit demo" AutomationProperties.Name="Exit demo" Style="{StaticResource QuietButton}" Background="{StaticResource Paper}" BorderBrush="{StaticResource Rule}" BorderThickness="1" Visibility="Collapsed" Click="ExitDemoClick" PointerEntered="DemoExitPointerEntered" PointerExited="DemoExitPointerExited"/>
 </Grid>
</Page>
