<Application x:Class="TypePressure.App"
       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- Load WinUI resources -->
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
      </ResourceDictionary.MergedDictionaries>

      <Color x:Key="SystemAccentColor">#E84D27</Color>
      <SolidColorBrush x:Key="Paper" Color="#F2F0E9"/><SolidColorBrush x:Key="Ink" Color="#20221F"/><SolidColorBrush x:Key="Muted" Color="#787A72"/><SolidColorBrush x:Key="Rule" Color="#D5D5CB"/><SolidColorBrush x:Key="Accent" Color="#E84D27"/><SolidColorBrush x:Key="Deck" Color="#EEEEE4"/><SolidColorBrush x:Key="Hover" Color="#E5E4DB"/><SolidColorBrush x:Key="Live" Color="#608258"/>
      <Style x:Key="Micro" TargetType="TextBlock"><Setter Property="FontFamily" Value="Consolas"/><Setter Property="FontSize" Value="10"/><Setter Property="CharacterSpacing" Value="80"/><Setter Property="Foreground" Value="{StaticResource Muted}"/></Style>
      <Style x:Key="Body" TargetType="TextBlock"><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{StaticResource Ink}"/></Style>
      <Style x:Key="Note" TargetType="TextBlock" BasedOn="{StaticResource Body}"><Setter Property="FontSize" Value="10"/><Setter Property="Foreground" Value="{StaticResource Muted}"/></Style>
      <Style x:Key="Brand" TargetType="TextBlock" BasedOn="{StaticResource Body}"><Setter Property="FontSize" Value="19"/><Setter Property="FontWeight" Value="ExtraBold"/><Setter Property="LineHeight" Value="17"/><Setter Property="CharacterSpacing" Value="-30"/></Style>
      <Style x:Key="Value" TargetType="TextBlock" BasedOn="{StaticResource Micro}"><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="CharacterSpacing" Value="0"/></Style>
      <Style x:Key="QuietButton" TargetType="Button">
       <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="Padding" Value="12,8"/><Setter Property="MinHeight" Value="40"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="12"/><Setter Property="CornerRadius" Value="3"/>
       <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="CommonStates"><VisualState x:Name="Normal"/><VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="Root.Background" Value="{StaticResource Hover}"/></VisualState.Setters></VisualState><VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="Root.Opacity" Value="0.65"/></VisualState.Setters></VisualState><VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="Root.Opacity" Value="0.4"/></VisualState.Setters></VisualState></VisualStateGroup></VisualStateManager.VisualStateGroups><ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Padding="{TemplateBinding Padding}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter>
      </Style>
      <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource QuietButton}"><Setter Property="Background" Value="{StaticResource Ink}"/><Setter Property="Foreground" Value="{StaticResource Paper}"/></Style>
      <Style x:Key="PresetButton" TargetType="ToggleButton"><Setter Property="FontSize" Value="11"/><Setter Property="Padding" Value="12,8"/><Setter Property="MinHeight" Value="38"/><Setter Property="CornerRadius" Value="3"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{StaticResource Ink}"/></Style>
      <Style x:Key="MaterialInput" TargetType="TextBox"><Setter Property="FontSize" Value="18"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="Padding" Value="0,4"/><Setter Property="MinHeight" Value="32"/></Style>
      <Style x:Key="AxisSlider" TargetType="Slider"><Setter Property="MinHeight" Value="28"/><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="IsThumbToolTipEnabled" Value="False"/></Style>

    </ResourceDictionary>
  </Application.Resources>

</Application>
